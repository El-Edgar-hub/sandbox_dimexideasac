[Unit]
Description=AR Sandbox
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=root
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/fran/.Xauthority
Environment=PYTHONPATH=/home/fran/libfreenect/wrappers/python
WorkingDirectory=/home/fran/sandbox_dimexideasac
ExecStart=/usr/bin/python3 -u /home/fran/sandbox_dimexideasac/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
